{
  "name": "streamsnap-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "lint": "eslint . --ext .ts,.tsx",
    "test:live-scan": "node modules/live-scan/scripts/verify-policy.mjs",
    "apk:tester": "cd android && ./gradlew :app:assembleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "expo": "^57.0.0",
    "expo-auth-session": "~57.0.11",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-observe": "~57.0.20",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-share-intent": "^8.0.0",
    "expo-sharing": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "live-scan": "file:./modules/live-scan",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.2.4",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "private": true
