{
  "manifest_version": 3,
  "name": "StreamSnap AI — Live Stream Visual Shopping",
  "version": "1.6.0",
  "description": "Visual product discovery for live streams. Point at anything on YouTube, Twitch, TikTok or Kick and find it on Amazon.",
  "homepage_url": "https://streamsnap.online",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "Open StreamSnap AI",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob: https://m.media-amazon.com https://images-na.ssl-images-amazon.com https://lh3.googleusercontent.com https://*.googleusercontent.com;"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "identity",
    "storage",
    "alarms",
    "tabs"
  ],
  "optional_permissions": [
    "scripting"
  ],
  "commands": {
    "scan-active-stream": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Scan the current video frame"
    }
  },
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.twitch.tv/*",
    "*://*.tiktok.com/*",
    "*://*.facebook.com/*",
    "*://*.kick.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.twitch.tv/*",
        "*://*.tiktok.com/*",
        "*://*.facebook.com/*",
        "*://*.kick.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/*",
        "assets/branding/*"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.twitch.tv/*",
        "*://*.tiktok.com/*",
        "*://*.facebook.com/*",
        "*://*.kick.com/*"
      ]
    }
  ]
}
